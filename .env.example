# =============================================================================
# Acadify - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and adjust your values.

# Optional: Demo Mode (set to "true" to explore the platform with mock data without a backend API)
DEMO_MODE=false

# Your backend API base URL (no trailing slash)
# Example: https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com

# Secret for session cookies (min 32 chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-super-secret-random-string-at-least-32-chars

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000